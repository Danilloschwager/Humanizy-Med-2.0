# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# Obrigatório — obtenha em https://console.groq.com/keys
GROQ_API_KEY=coloque_sua_chave_aqui

# Opcionais (valores padrão já definidos em app/config.py)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.5
GROQ_TIMEOUT_SECONDS=15

NOMINATIM_CONTACT_EMAIL=contato@seudominio.com.br
NOMINATIM_CACHE_TTL_SECONDS=3600

# Lista separada por vírgulas das origens autorizadas a chamar a API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
